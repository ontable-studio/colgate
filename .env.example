# Google Apps Script web app URL that receives play results (leave empty to disable sync)
VITE_SYNC_ENDPOINT=
# Shared secret checked by the Apps Script (noise reduction, not a real security boundary)
VITE_SYNC_SECRET=
# Identifier of this booth device (shown in the sheet)
VITE_DEVICE_ID=booth-01
# Public address of the deployed game, used for canonical and share-card (Open Graph) links
VITE_SITE_URL=
